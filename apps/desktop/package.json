{
    "name": "@focuson/desktop",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "main": "dist-electron/main/index.cjs",
    "scripts": {
        "dev": "next dev -H 127.0.0.1 -p 3000",
        "dev:electron": "pnpm build:electron && electron .",
        "preview:electron": "pnpm build && FOCUSON_RENDERER_MODE=production electron .",
        "build:electron": "tsc -p tsconfig.electron.json && node scripts/build-electron-preload.cjs",
        "build": "tsc --noEmit && pnpm build:electron && next build --webpack",
        "test:electron": "pnpm build:electron && node --test tests/electron/*.test.cjs",
        "lint": "eslint ."
    },
    "dependencies": {
        "@focuson/shared-types": "workspace:*",
        "@napi-rs/keyring": "^2.1.1",
        "electron": "^44.1.0",
        "next": "^16.3.4",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.1",
        "eslint-config-next": "^16.3.4",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.11.0",
        "postcss": "^8.5.28",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.67.0"
    }
}
