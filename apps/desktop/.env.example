# 이 파일을 apps/desktop/.env로 복사해 실제 값을 넣는다. .env는 Git에 올라가지 않는다.
# Electron은 .env를 자동으로 읽지 않는다. 저장소 루트에서 `set -a && source apps/desktop/.env && set +a`로 읽은 뒤 실행한다.

# Google Cloud에서 애플리케이션 유형을 '데스크톱 앱'으로 만든 OAuth Client ID
FOCUSON_GOOGLE_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com

# Backend origin. 로컬 개발 예시다.
FOCUSON_API_BASE_URL=http://127.0.0.1:8080
