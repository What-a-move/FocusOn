# Local development example only. Replace this value in .env and never commit .env.
# local 프로필이 자동으로 읽는다. KEY=VALUE 형식으로 작성하고 따옴표·export는 붙이지 않는다.
POSTGRES_DB=focuson
POSTGRES_USER=focuson
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8080
DB_MAX_POOL_SIZE=10
# 다음 명령으로 고유한 값을 생성한다: openssl rand -base64 32
JWT_SECRET_BASE64=replace-with-a-base64-encoded-32-byte-key

# Desktop과 동일한 Google OAuth Desktop client. Secret이 발급된 클라이언트는 서버에만 설정한다.
GOOGLE_DESKTOP_CLIENT_ID=your-desktop-client-id.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_SECRET=

# Separate from JWT; generate once with openssl rand -base64 32 and retain across deploys.
PAIRING_SECRET_BASE64=replace-with-a-separate-base64-encoded-32-byte-key

# 정확한 chrome-extension://<32자리 ID>를 콤마로 구분. local은 생략 시 개발 ID 허용.
# docker는 생략 시 확장 CORS 전체 불허. 아래는 개발 QA용이다.
CORS_ALLOWED_ORIGINS=chrome-extension://fbhlmioghblalhmcokcpoapjpnjccbde

# AI 내부 서비스 origin과 AI 서비스의 동일한 공유 키. 비어 있으면 분석은 UNCERTAIN.
# local: 예) http://127.0.0.1:8000 / docker: 컨테이너에서 접근 가능한 서비스 주소 사용.
AI_ANALYSIS_URL=
FOCUSON_AI_API_KEY=
