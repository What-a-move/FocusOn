# TypeSafe JEV (System One)
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_LOG_LEVEL=warning

# Claude structured generation (CLAUDE_API_KEY is also accepted)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=1200
# Race up to two question drafts; only one valid question is shown.
CLAUDE_QUESTION_PARALLELISM=2
# Question generation falls back to a local question after this many seconds.
CLAUDE_QUESTION_DEADLINE_SECONDS=10

# Local comparison only. It never controls the JEV workflow or saved goal.
LAYA_COMPARISON_ENABLED=true
LAYA_COMPARISON_MODEL=convaiinnovations/laya-multilingual

# Goal assistance runtime
GOAL_ASSISTANCE_TIMEOUT_SECONDS=10
GOAL_ASSISTANCE_MAX_RETRIES=2

# Experimental routing thresholds. Tune with the fixed evaluation set.
INVALID_USABLE_MAX=0.20
UNCLEAR_TERM_MIN=0.70
MULTIPLE_GOALS_MIN=0.70
USABLE_CONFIDENT_MIN=0.60
CLEAR_SPECIFICITY_MIN=2.00
SUGGESTION_SPECIFICITY_MIN=1.00
SPECIFICITY_CONFIDENCE_MIN=0.45
GENERATED_RESULT_PASS_MIN=0.70

# Input limits
GOAL_TEXT_MAX_LENGTH=200
CLARIFICATION_ANSWER_MAX_LENGTH=500
CLARIFICATION_ANSWERS_MAX_COUNT=20

# LangSmith trace controls. Keep tracing off unless a local test needs it.
LANGSMITH_TRACING=false
# Local test only: include the submitted goal and clarification answers in traces.
# Never enable this in a shared or deployed environment.
LANGSMITH_TRACE_RAW_GOAL_TEXT=false

# Beta test only: return uncalibrated Hybrid candidates as decisions.
# Set to safe after confidence calibration before production use.
FOCUSON_ANALYSIS_DECISION_MODE=candidate
FOCUSON_EMBEDDING_URL=http://127.0.0.1:11435
FOCUSON_EMBEDDING_KEEP_ALIVE=10m
FOCUSON_EMBEDDING_TIMEOUT_SECONDS=4.0
FOCUSON_EMBEDDING_MAX_RETRIES=0
