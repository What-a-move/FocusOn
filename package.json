{
    "name": "focus-on",
    "private": true,
    "packageManager": "pnpm@11.19.0",
    "scripts": {
        "dev:desktop": "pnpm --filter @focuson/desktop dev",
        "dev:extension": "pnpm --filter @focuson/extension dev",
        "dev:server": "./server/gradlew bootRun",
        "build:desktop": "pnpm --filter @focuson/desktop build",
        "build:extension": "pnpm --filter @focuson/extension build",
        "build:server": "./server/gradlew build",
        "test:server": "./server/gradlew test",
        "lint": "pnpm -r lint",
        "build": "pnpm -r build",
        "install:all": "pnpm install"
    }
}
