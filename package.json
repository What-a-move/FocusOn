{
    "name": "focus-on",
    "private": true,
    "packageManager": "pnpm@11.19.0",
    "scripts": {
        "dev": "turbo run dev",
        "dev:desktop": "turbo run dev --filter=@focuson/desktop",
        "dev:extension": "turbo run dev --filter=@focuson/extension",
        "dev:server": "./server/gradlew -p server bootRun",
        "build": "turbo run build",
        "build:desktop": "turbo run build --filter=@focuson/desktop",
        "build:extension": "turbo run build --filter=@focuson/extension",
        "build:server": "./server/gradlew -p server build",
        "test:server": "./server/gradlew -p server test",
        "lint": "turbo run lint",
        "install:all": "pnpm install"
    },
    "devDependencies": {
        "turbo": "^2.10.12"
    }
}
